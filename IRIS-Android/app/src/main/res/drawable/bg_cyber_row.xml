<?xml version="1.0" encoding="utf-8"?>
<!--
  Ordinary archive row: dark slab with a cyan edge strip on the left.

  Wrapped in a ripple because rows are long-pressable (that is the only per-row delete route), and
  without press feedback a long press on a dark slab gives no sign it registered.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_deck">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/deck_card" />
                    <stroke android:width="1dp" android:color="@color/deck_border" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:width="2dp" android:gravity="left|fill_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="@color/deck_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
