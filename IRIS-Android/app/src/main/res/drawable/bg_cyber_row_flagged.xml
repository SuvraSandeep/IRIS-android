<?xml version="1.0" encoding="utf-8"?>
<!--
  Flagged archive row: same slab, but the left strip is wider and in the error colour.

  A deleted or unsent message is the whole reason this screen exists, so it is given a distinct
  edge rather than relying on text colour alone. Deliberately does NOT distinguish confirmed from
  suspected: that distinction is carried by the [STATUS] line, which is worded so a guess can never
  be mistaken for a fact, and duplicating it in colour would invite reading a colour as proof.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_deck">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/deck_card" />
                    <stroke android:width="1dp" android:color="@color/deck_error" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:width="4dp" android:gravity="left|fill_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="@color/deck_error" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
