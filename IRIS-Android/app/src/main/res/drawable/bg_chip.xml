<?xml version="1.0" encoding="utf-8"?>
<!-- Pill chip with press ripple. Inner shape keeps the background layer id so runtime
     accent tinting can still reach it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_deck">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#1A1D3A" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#2D3258" />
        </shape>
    </item>
</ripple>
