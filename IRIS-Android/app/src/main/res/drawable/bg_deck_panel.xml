<?xml version="1.0" encoding="utf-8"?>
<!--
  Command Deck panel with small illuminated corner brackets (spec §1).
  Built from layers: dark fill + thin border, then four accent corner marks created by
  offsetting bright squares and masking them with the card fill.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- accent glow that the brackets are cut from -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/deck_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- mask: hides the accent except at the four corners -->
    <item
        android:left="0dp"
        android:top="7dp"
        android:right="0dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/deck_card" />
        </shape>
    </item>
    <item
        android:left="7dp"
        android:top="0dp"
        android:right="7dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/deck_card" />
        </shape>
    </item>

    <!-- inner body + border -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/deck_card" />
            <stroke android:width="1dp" android:color="@color/deck_border" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
