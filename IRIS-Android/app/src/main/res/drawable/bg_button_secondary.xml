<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#33375A" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#7C83A9" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#252741" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#41466A" />
        </shape>
    </item>
</selector>
