<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#252847" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#4B5088" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#171937" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#2D3258" />
        </shape>
    </item>
</selector>
