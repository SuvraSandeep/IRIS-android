<?xml version="1.0" encoding="utf-8"?>
<!--
  Archive screen, styled as instrumentation rather than a dashboard: monospace throughout, hard
  near-square corners, hollow outlined controls and neon edge strips.

  Built on the existing Command Deck tokens. deck_accent carries the owner's chosen accent colour,
  so the cyan edges follow the theme; magenta is used as a fixed second accent that belongs to this
  screen alone. The one exception is the WIPE ALL outline, which is pinned to the error colour so
  it cannot be themed into looking harmless.

  Copy is in IRIS's own voice at the owner's request. The exception is the [STATUS: ...] marker on
  each row, generated in DeletedMessageRules: that text also lands in CSV exports and a pinned test
  asserts a suspected deletion can never read as a confirmed one. Jokes there would undermine the
  only part of this screen that functions as evidence.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.3"
        android:text="RECEIPT VAULT"
        android:textColor="@color/deck_accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Double neon rule: thick accent over a thin magenta trace. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="6dp"
        android:background="@color/deck_accent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:background="@color/magenta" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="I write down every notification from the apps you tick, STG. When somebody deletes a message hoping you never saw it \u2014 I already have it. I\u0027m not saying I enjoy this. I\u0027m saying I\u0027m unreasonably good at it."
        android:textColor="@color/deck_text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cyber_panel"
        android:orientation="vertical"
        android:paddingBottom="11dp"
        android:paddingLeft="13dp"
        android:paddingRight="11dp"
        android:paddingTop="11dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:text="DIAGNOSTICS"
            android:textColor="@color/magenta"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/archiveSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:text="spinning up\u2026 pretending that took effort"
            android:textColor="@color/deck_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/archiveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:textColor="@color/deck_text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/archiveWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:textColor="@color/deck_error"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Shown only while notification access is missing, so the screen is not permanently
         nagging about a permission that is already granted. -->
    <Button
        android:id="@+id/archiveGrantButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_button_primary"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:text="GRANT ME EYES"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/archiveAppsButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="TARGETS"
            android:textAllCaps="false"
            android:textColor="@color/deck_accent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/archiveRefreshButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="RESCAN"
            android:textAllCaps="false"
            android:textColor="@color/deck_accent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/archiveExportButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="EXPORT"
            android:textAllCaps="false"
            android:textColor="@color/deck_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/archiveSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cyber_input"
        android:fontFamily="monospace"
        android:hint="search the receipts\u2026"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="46dp"
        android:paddingBottom="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:textColor="@color/deck_accent"
        android:textColorHint="@color/deck_inactive"
        android:textSize="12sp" />

    <Switch
        android:id="@+id/archiveFlaggedOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        android:minHeight="46dp"
        android:text="EVIDENCE ONLY - hide the innocent"
        android:textColor="@color/deck_text"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/deck_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/archiveList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Undo window for a swiped row. The delete is held, not yet written, so undo cancels a
         timer rather than re-inserting: the append-only history is never actually disturbed. -->
    <LinearLayout
        android:id="@+id/archiveUndoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:paddingLeft="13dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/archiveUndoLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/deck_text_dim"
            android:textSize="11sp" />

        <Button
            android:id="@+id/archiveUndoButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:minWidth="96dp"
            android:text="UNDO"
            android:textAllCaps="false"
            android:textColor="@color/magenta"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/magenta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/archiveBackButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="BACK"
            android:textAllCaps="false"
            android:textColor="@color/deck_accent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/archiveInspectButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="PROBE"
            android:textAllCaps="false"
            android:textColor="@color/magenta"
            android:textSize="11sp" />

        <Button
            android:id="@+id/archiveDeleteAllButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button_danger"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="WIPE ALL"
            android:textAllCaps="false"
            android:textColor="@color/deck_error"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
