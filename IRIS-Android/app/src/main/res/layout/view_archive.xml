<?xml version="1.0" encoding="utf-8"?>
<!--
  Archive screen, styled as a terminal readout on the existing Command Deck palette rather than a
  new theme: deck_accent / deck_card / deck_border are the tokens ThemeManager already retints, so
  this screen follows the owner's chosen accent instead of hard-coding cyan.

  Copy is deliberately in IRIS's own voice, at the owner's request. The one exception is the
  [STATUS: ...] marker on each row, generated in DeletedMessageRules: that is forensic text that
  also lands in exports, and a pinned test asserts a suspected deletion can never read as a
  confirmed one. Jokes there would undermine the only part of this screen that is evidence.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:text="// RECEIPT VAULT"
        android:textColor="@color/deck_accent"
        android:textSize="21sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="@color/deck_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="monospace"
        android:text="I write down every notification from the apps you tick, STG. When somebody deletes a message hoping you never saw it \u2014 I already have it. I\u0027m not saying I enjoy this. I\u0027m saying I\u0027m unreasonably good at it."
        android:textColor="@color/deck_text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_deck_panel"
        android:orientation="vertical"
        android:padding="11dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:text="DIAGNOSTICS"
            android:textColor="@color/deck_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/archiveSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:text="spinning up\u2026 pretending that took effort"
            android:textColor="@color/deck_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/archiveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/deck_text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/archiveWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/deck_error"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Shown only while notification access is missing. Hidden the rest of the time so the
         screen is not permanently nagging about a permission that is already granted. -->
    <Button
        android:id="@+id/archiveGrantButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_primary"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:text="[ ! ] GRANT ME EYES"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/archiveAppsButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_deck_card"
            android:fontFamily="monospace"
            android:text="[ TARGETS ]"
            android:textAllCaps="false"
            android:textColor="@color/deck_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/archiveRefreshButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_deck_card"
            android:fontFamily="monospace"
            android:text="[ RESCAN ]"
            android:textAllCaps="false"
            android:textColor="@color/deck_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/archiveExportButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_deck_card"
            android:fontFamily="monospace"
            android:text="[ EXPORT ]"
            android:textAllCaps="false"
            android:textColor="@color/deck_text"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/archiveSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_deck_card"
        android:fontFamily="monospace"
        android:hint="\u003E search the receipts\u2026"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/deck_accent"
        android:textColorHint="@color/deck_text_dim"
        android:textSize="12sp" />

    <Switch
        android:id="@+id/archiveFlaggedOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.05"
        android:minHeight="48dp"
        android:text="EVIDENCE ONLY - hide the innocent"
        android:textColor="@color/deck_text"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/archiveList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/deck_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/archiveBackButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_deck_card"
            android:fontFamily="monospace"
            android:text="&lt; BACK"
            android:textAllCaps="false"
            android:textColor="@color/deck_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/archiveDeleteAllButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_deck_card"
            android:fontFamily="monospace"
            android:text="WIPE ALL"
            android:textAllCaps="false"
            android:textColor="@color/deck_error"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
