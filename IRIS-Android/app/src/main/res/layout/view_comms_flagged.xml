<?xml version="1.0" encoding="utf-8"?>
<!--
  FLAGGED & REMINDERS section.
  Displays pinned messages, urgent flagged alerts, and scheduled reminders in a single unified view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_panel"
        android:orientation="vertical"
        android:paddingBottom="11dp"
        android:paddingLeft="13dp"
        android:paddingRight="11dp"
        android:paddingTop="11dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:text="PINNED, FLAGGED &amp; REMINDERS"
            android:textColor="@color/magenta"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flaggedSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="0 PINNED · 0 FLAGGED · 0 REMINDERS"
            android:textColor="@color/deck_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/flaggedFilterAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:text="ALL"
            android:textAllCaps="false"
            android:textColor="@color/magenta"
            android:textSize="10sp" />

        <Button
            android:id="@+id/flaggedFilterPinned"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:text="PINNED 📌"
            android:textAllCaps="false"
            android:textColor="@color/deck_inactive"
            android:textSize="10sp" />

        <Button
            android:id="@+id/flaggedFilterFlagged"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:text="FLAGGED 🚩"
            android:textAllCaps="false"
            android:textColor="@color/deck_inactive"
            android:textSize="10sp" />

        <Button
            android:id="@+id/flaggedFilterReminders"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:text="REMINDERS ⏰"
            android:textAllCaps="false"
            android:textColor="@color/deck_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/flaggedSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_cyber_input"
        android:fontFamily="monospace"
        android:hint="&gt; search pinned, flagged &amp; reminders…"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="44dp"
        android:paddingBottom="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:textColor="@color/deck_accent"
        android:textColorHint="@color/deck_inactive"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/flaggedAddButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="+ NEW ITEM"
            android:textAllCaps="false"
            android:textColor="@color/deck_accent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/flaggedClearCompletedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_button"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="CLEAR COMPLETED"
            android:textAllCaps="false"
            android:textColor="@color/deck_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/flaggedListHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
