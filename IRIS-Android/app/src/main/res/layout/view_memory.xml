<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_accent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="\uD83E\uDDE0  IRIS MEMORY"
            android:textColor="@color/cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/memorySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0 memories \u2022 Teach me about yourself"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addMemoryButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:text="\uFF0B  Add"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/speakMemoryButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:text="\uD83C\uDF99 Speak"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/searchMemoryButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="0.7"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="Search memories"
                android:text="\uD83D\uDD0D"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/suggestionsHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/memoryListHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/exportMemoryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="\uD83D\uDCE4 Export"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/importMemoryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="\uD83D\uDCE5 Import"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/clearMemoryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="0.7"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="Clear all memories"
            android:text="\uD83D\uDDD1"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
