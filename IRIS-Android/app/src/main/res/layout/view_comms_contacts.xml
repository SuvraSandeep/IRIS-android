<?xml version="1.0" encoding="utf-8"?>
<!--
  CONTACTS section. Skeleton only: the rows repeat per contact and are built in MainActivity.

  The list is drawn from the archive rather than the phone book. The phone book would list
  hundreds of people who have never messaged, and would omit the unsaved numbers that matter most
  when deciding who IRIS may answer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_panel"
        android:orientation="vertical"
        android:paddingBottom="11dp"
        android:paddingLeft="13dp"
        android:paddingRight="11dp"
        android:paddingTop="11dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:text="THE GUEST LIST"
            android:textColor="@color/magenta"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contactsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="reading who you actually talk to\u2026"
            android:textColor="@color/deck_text"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/contactsSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_cyber_input"
        android:fontFamily="monospace"
        android:hint="\u003E find someone\u2026"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="46dp"
        android:paddingBottom="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:textColor="@color/deck_accent"
        android:textColorHint="@color/deck_inactive"
        android:textSize="12sp" />

    <Button
        android:id="@+id/contactsAddButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_cyber_button"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:text="+ ADD SOMEONE BY NAME"
        android:textAllCaps="false"
        android:textColor="@color/magenta"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contactsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>
