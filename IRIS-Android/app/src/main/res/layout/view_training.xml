<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="20dp">
        <LinearLayout android:id="@+id/wakeSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_voice_studio" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="YOUR VOICE, YOUR IRIS" android:textColor="#69E6CD" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/ownerIntroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Let’s make this personal." android:textSize="27sp" android:textStyle="bold" android:textColor="@color/text_primary" />
            <TextView android:id="@+id/ownerIntroSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="One clear phrase. A voice profile that stays on your phone. You control when each take starts." android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="4dp" />
            <TextView android:id="@+id/micLabelTraining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="\uD83C\uDF99 Listening mic: —" android:textColor="@color/text_muted" android:textSize="12sp" />
            <TextView android:id="@+id/wakeTrainingStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="⚠️  Not configured yet" android:textColor="@color/text_muted" android:textSize="13sp" />
            <LinearLayout android:id="@+id/wakeNormalState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <EditText android:id="@+id/wakePhraseInput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_chip" android:hint="Your phrase · for example, Hello Iris" android:paddingLeft="16dp" android:paddingRight="16dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="18sp" android:minHeight="60dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                    <Button android:id="@+id/trainWakeButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_button_primary" android:text="\uD83C\uDFA4  Set Up Wake Phrase" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
                    <Button android:id="@+id/testWakeButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginLeft="8dp" android:layout_weight="0.6" android:background="@drawable/bg_button_secondary" android:enabled="false" android:text="\uD83E\uDDEA Test" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Extra wake phrases (optional, up to 2 more)" android:textColor="@color/text_muted" android:textSize="12sp" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:visibility="gone">
                    <EditText android:id="@+id/altWakeInput" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_chip" android:hint="e.g. IRIS you there" android:paddingLeft="14dp" android:paddingRight="14dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp" android:importantForAutofill="no" />
                    <Button android:id="@+id/addAltWakeButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginLeft="6dp" android:background="@drawable/bg_button_secondary" android:text="\uFF0B Add" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:id="@+id/altWakeList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" android:textColor="@color/text_secondary" android:textSize="12sp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/wakeWizardState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/wakeWizardStep" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Preparing training" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/wakeWizardDots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 14" android:textColor="@color/cyan" android:textSize="18sp" />
                </LinearLayout>
                <ProgressBar android:id="@+id/ownerTakeProgress" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="14dp" android:max="14" android:progress="0" android:progressTint="#69E6CD" android:progressBackgroundTint="#27364B" style="?android:attr/progressBarStyleHorizontal" />
                <TextView android:id="@+id/ownerPhraseHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Hello Iris" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <com.iris.assistant.VoiceTrainingVisualizer android:id="@+id/ownerVoiceMeter" android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/wakeWizardPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="Wait for the models and microphone to be ready before speaking." android:textColor="@color/text_secondary" android:textSize="15sp" />
                <TextView android:id="@+id/wakeWizardFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Preparing — microphone not started" android:textColor="#69E6CD" android:textSize="14sp" android:textStyle="bold" />
                <Button android:id="@+id/ownerRecordButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:text="Record this take" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/bg_button_primary" android:textColor="@color/text_primary" android:visibility="gone" />
                <Button android:id="@+id/ownerRetryButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Retry this take" android:textAllCaps="false" android:visibility="gone" android:background="@drawable/bg_button_secondary" android:textColor="@color/text_primary" />
                <Button android:id="@+id/wakeWizardCancel" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_button_secondary" android:text="Cancel training" android:textAllCaps="false" android:textColor="@color/danger" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/otherTrainingToggle" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="Command &amp; contact practice  ›" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/bg_button_secondary" />
        <LinearLayout android:id="@+id/otherTrainingPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:id="@+id/voiceTrainSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card_accent" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="\uD83C\uDF9B  VOICE &amp; COMMAND TRAINING" android:textColor="@color/mint" android:textSize="11sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/voiceTrainNormalState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/voiceTrainStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Not trained yet" android:textColor="@color/text_secondary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Read a few phrases so IRIS learns your talking pattern, then say each command word so it understands your pronunciation. All on-device." android:textColor="@color/text_muted" android:textSize="12sp" />
                    <Button android:id="@+id/startVoiceTrainButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/bg_button_primary" android:text="\uD83C\uDF93  Learn My Voice &amp; Commands" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/voiceTrainWizardState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/voiceTrainStep" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Warming up…" android:textColor="@color/mint" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/voiceTrainPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="64dp" android:text="Getting the voice engine ready…" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/voiceTrainFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" android:textColor="@color/magenta" android:textSize="14sp" android:textStyle="bold" />
                    <Button android:id="@+id/voiceTrainCancel" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_button_secondary" android:text="Cancel" android:textAllCaps="false" android:textColor="@color/danger" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/contactSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="\uD83D\uDCC7  CONTACT COMMANDS" android:textColor="@color/magenta" android:textSize="11sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/contactNormalState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/profileSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="0 contacts • 0 phrases" android:textColor="@color/text_secondary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Teach IRIS how you naturally ask to call someone." android:textColor="@color/text_muted" android:textSize="12sp" />
                    <Button android:id="@+id/startTrainingButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:background="@drawable/bg_button_primary" android:text="＋  Train New Contact" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/contactWizardState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/contactWizardStep" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sample 1 of 3" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                        <TextView android:id="@+id/contactWizardDots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 14" android:textColor="@color/magenta" android:textSize="18sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/trainingContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Training: Mom" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/trainingPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="44dp" android:text="Say how you'd ask IRIS to call this person." android:textColor="@color/text_secondary" android:textSize="15sp" />
                    <TextView android:id="@+id/contactWizardFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="\uD83D\uDD34  Listening…" android:textColor="@color/magenta" android:textSize="14sp" android:textStyle="bold" />
                    <Button android:id="@+id/contactWizardCancel" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_button_secondary" android:text="Cancel" android:textAllCaps="false" android:textColor="@color/danger" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/profileListHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="\uD83E\uDDEA  TEST &amp; TRANSFER" android:textColor="@color/violet" android:textSize="11sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button android:id="@+id/testCommandsButton" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_button_secondary" android:text="\uD83D\uDCDE Test Command" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:background="@color/border_subtle" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/exportProfileButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_button_secondary" android:text="\uD83D\uDCE4 Export" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="12sp" />
                    <Button android:id="@+id/importProfileButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginLeft="8dp" android:layout_weight="1" android:background="@drawable/bg_button_secondary" android:text="\uD83D\uDCE5 Import" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>