<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How IRIS behaves"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Power without the mysterious switches."
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="APPEARANCE" android:textColor="@color/magenta" android:textSize="11sp" android:textStyle="bold" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Accent colour"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <LinearLayout android:id="@+id/accentRow" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <Switch android:id="@+id/amoledSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="AMOLED black background" android:textColor="@color/text_primary" android:textSize="14sp" />

            <Switch android:id="@+id/reduceMotionSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Reduce motion" android:textColor="@color/text_primary" android:textSize="14sp" />

            <Switch android:id="@+id/densitySwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Compact layout" android:textColor="@color/text_primary" android:textSize="14sp" />

            <Button android:id="@+id/editChipsButton" android:layout_width="match_parent"
                android:layout_height="48dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Edit home quick actions" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Theme and accent apply instantly."
                android:textColor="@color/text_muted" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="LISTENING MODE" android:textColor="@color/cyan" android:textSize="11sp" android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/listeningModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <RadioButton android:id="@+id/modeWake" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Custom wake phrase — recommended" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/modeTap" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Tap to talk — best battery" android:textColor="@color/text_primary" />
                <RadioButton android:id="@+id/modeContinuous" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Continuous recognition — experimental" android:textColor="@color/text_primary" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="11dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="MICROPHONE" android:textColor="@color/cyan" android:textSize="11sp" android:textStyle="bold" />
            <Spinner android:id="@+id/microphoneSpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="5dp" />
            <Switch android:id="@+id/onDeviceSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Prefer on-device speech (may reduce accent accuracy)" android:textColor="@color/text_primary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="For Indian-accent English: choose English (India) and leave on-device preference OFF. System speech may send audio to its provider for recognition. Offline Vosk uses Indian English; it is not a Hindi model."
                android:textColor="@color/text_muted" android:textSize="12sp" />
            <Button android:id="@+id/indianAccuracyButton" android:layout_width="match_parent" android:layout_height="48dp"
                android:text="Set up Indian English accuracy" android:background="@drawable/bg_button_secondary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Command language" android:textColor="@color/text_muted" android:textSize="12sp" />
            <Spinner android:id="@+id/languageSpinner" android:layout_width="match_parent" android:layout_height="50dp" />
            <Button android:id="@+id/testTtsButton" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_button_secondary"
                android:text="\uD83D\uDD0A Test voice — tap to hear IRIS" android:textAllCaps="false" android:textColor="@color/text_primary" />
            <Button android:id="@+id/downloadModelButton" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_button_secondary"
                android:text="Offline speech model — check status" android:textAllCaps="false" android:textColor="@color/text_primary" />
            <Switch android:id="@+id/lockControlSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Control from lock screen" android:textColor="@color/text_primary" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Let IRIS act while your phone is locked. Quick actions (texts, torch, volume, info, reminders) run instantly; opening apps (WhatsApp, Maps, email…) asks for a fingerprint/PIN first."
                android:textColor="@color/text_muted" android:textSize="11sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="VOICE SECURITY"
                android:textColor="@color/mint" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/voiceprintStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Voiceprint: not enrolled — train your wake phrase to enroll."
                android:textColor="@color/text_muted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Recognition sensitivity (lenient ↔ strict)"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
            <SeekBar android:id="@+id/sensitivitySeek" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:max="100" />
            <Switch android:id="@+id/voiceCueSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Speak when a voice isn't recognized" android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/shakeSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Shake the phone to talk to IRIS" android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/headsetSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Double-press headset button to talk (may take over the earphone button from music apps)"
                android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/mirrorSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Show IRIS replies as a notification (visible on your watch)"
                android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/mirrorAlwaysSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="  ↳ Even when the screen is on"
                android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/mirrorMajorSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="  ↳ Skip greetings and small cues"
                android:textColor="@color/text_primary" android:textSize="14sp" />
            <Button android:id="@+id/clearVoiceprintButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_button_secondary"
                android:text="Clear voice security" android:textAllCaps="false" android:textColor="@color/danger" android:textSize="13sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="COMMAND DECK (home screen)"
                android:textColor="@color/mint" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Every part of the home screen can be turned off, resized or slowed down."
                android:textColor="@color/text_muted" android:textSize="11sp" />
            <Switch android:id="@+id/deckTelemetrySwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Show system telemetry panels" android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/deckActivitySwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Show activity stream" android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/deckTilesSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Show summary tiles (battery, RAM, network, devices)" android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/deckSaverSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Battery-saving visuals (no continuous animation)" android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/deckScanlineSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Faint background scanline" android:textColor="@color/text_primary" android:textSize="14sp" />
            <Switch android:id="@+id/deckPublicIpSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Allow public IP lookup (contacts an outside service — off by default)"
                android:textColor="@color/text_primary" android:textSize="14sp" />
            <TextView android:id="@+id/deckOrbSizeLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Orb size: 200dp"
                android:textColor="@color/text_muted" android:textSize="12sp" />
            <SeekBar android:id="@+id/deckOrbSizeSeek" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp" android:max="140" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Telemetry tab shown first"
                android:textColor="@color/text_muted" android:textSize="12sp" />
            <Spinner android:id="@+id/deckTabSpinner" android:layout_width="match_parent"
                android:layout_height="50dp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="RECOGNITION &amp; LEARNING"
                android:textColor="@color/mint" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Teach IRIS how you say things, and see how well it is actually hearing you. Everything stays on this phone."
                android:textColor="@color/text_muted" android:textSize="11sp" />
            <Button android:id="@+id/fixMisheardButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary"
                android:text="Fix what IRIS misheard" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:textSize="13sp" />
            <Button android:id="@+id/vocabularyButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary"
                android:text="My words &amp; name pronunciations" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:textSize="13sp" />
            <Button android:id="@+id/recognitionReportButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary"
                android:text="Recognition report" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:textSize="13sp" />
            <Button android:id="@+id/activityTimelineButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary"
                android:text="What IRIS did (activity)" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:textSize="13sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="TEACH IRIS (feedback)"
                android:textColor="@color/mint" android:textSize="11sp" android:textStyle="bold" />
            <Button android:id="@+id/feedbackMissedButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary"
                android:text="It missed me — learn my voice &amp; ease up" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:textSize="13sp" />
            <Button android:id="@+id/feedbackFalseButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary"
                android:text="It woke for someone else — make it stricter" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:textSize="13sp" />

            <Switch android:id="@+id/highAccuracyVoiceSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="High-accuracy voice model (large, ~1GB)" android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Downloads a larger offline Indian-English model for noticeably better recognition of your accent. One-time ~1GB download; uses more storage and RAM. Falls back to the small model automatically if it can't load."
                android:textColor="@color/text_muted" android:textSize="11sp" />

            <Switch android:id="@+id/aiEnabledSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="Use AI brain (experimental)" android:textColor="@color/text_primary" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Off by default. Rule-based replies handle all commands reliably. Turn on for conversational AI (may be unstable on some phones)."
                android:textColor="@color/text_muted" android:textSize="11sp" />
            <Button android:id="@+id/downloadBrainButton" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_button_primary"
                android:text="\uD83E\uDDE0 Download AI brain (~550 MB)" android:textAllCaps="false"
                android:textColor="@color/text_primary" android:textStyle="bold" />
            <TextView android:id="@+id/brainStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="AI brain: not installed (using rule-based replies)"
                android:textColor="@color/text_muted" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="The default AI brain is open (no account needed) — just tap Download. The token field below is optional, only needed if you switch to a gated model."
                android:textColor="@color/text_muted" android:textSize="11sp" />
            <EditText android:id="@+id/hfTokenInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary" android:padding="12dp"
                android:hint="Paste Hugging Face token (hf_...)" android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary" android:textSize="13sp" android:inputType="textNoSuggestions"
                android:maxLines="1" android:importantForAutofill="no" />
            <Button android:id="@+id/saveTokenButton" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary"
                android:text="Save token" android:textAllCaps="false" android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="11dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="SERVER MODE (ONLINE BRAIN)" android:textColor="@color/cyan"
                android:textSize="11sp" android:textStyle="bold" />
            <Switch android:id="@+id/serverModeSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Use my server when online" android:textColor="@color/text_primary" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Off by default. Enables your private server for replies and optional Whisper transcription. Separately, Android system speech may use its provider online even when Server mode is off. See SERVER-MODE.md."
                android:textColor="@color/text_muted" android:textSize="11sp" />
            <EditText android:id="@+id/serverUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:background="@drawable/bg_button_secondary" android:padding="12dp"
                android:hint="Server URL (https://your-server)" android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary" android:textSize="13sp" android:inputType="textUri"
                android:maxLines="1" android:importantForAutofill="no" />
            <EditText android:id="@+id/serverTokenInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary" android:padding="12dp"
                android:hint="Server token (bearer)" android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary" android:textSize="13sp" android:inputType="textNoSuggestions"
                android:maxLines="1" android:importantForAutofill="no" />
            <Switch android:id="@+id/serverSttSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Send audio to server (Whisper) for best accent" android:textColor="@color/text_primary"
                android:textSize="13sp" />
            <Switch android:id="@+id/serverTtsSwitch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="Use the server's voice (Piper) for replies" android:textColor="@color/text_primary"
                android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/saveServerButton" android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_weight="1" android:background="@drawable/bg_button_primary"
                    android:text="Save" android:textAllCaps="false" android:textColor="@color/text_primary" android:textStyle="bold" />
                <Button android:id="@+id/testServerButton" android:layout_width="0dp" android:layout_height="48dp"
                    android:layout_marginLeft="8dp" android:layout_weight="1" android:background="@drawable/bg_button_secondary"
                    android:text="Test connection" android:textAllCaps="false" android:textColor="@color/text_primary" />
            </LinearLayout>
            <TextView android:id="@+id/serverStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Not configured" android:textColor="@color/text_muted" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="11dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="VOICE &amp; DIAGNOSTICS" android:textColor="@color/cyan" android:textSize="11sp" android:textStyle="bold" />
            <Button android:id="@+id/chooseVoiceButton" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_button_secondary"
                android:text="\uD83D\uDD08 Choose IRIS voice" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" />
            <Button android:id="@+id/testVoiceButton" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_secondary"
                android:text="\u25B6 Test voice" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" />
            <Button android:id="@+id/selfTestButton" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="6dp" android:background="@drawable/bg_button_primary"
                android:text="\uD83E\uDE7A Run self-test" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="11dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PERSONALITY &amp; FEEDBACK" android:textColor="@color/magenta" android:textSize="11sp" android:textStyle="bold" />
            <Spinner android:id="@+id/personalitySpinner" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="5dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Text size" android:textColor="@color/text_muted" android:textSize="12sp" />
            <Spinner android:id="@+id/textSizeSpinner" android:layout_width="match_parent" android:layout_height="50dp" />
            <Switch android:id="@+id/voiceRepliesSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Voice replies" android:textColor="@color/text_primary" />
            <Switch android:id="@+id/hapticsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Haptic feedback" android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="11dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PRIVACY &amp; SAFETY" android:textColor="@color/mint" android:textSize="11sp" android:textStyle="bold" />
            <Switch android:id="@+id/speakerVerificationSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="\uD83D\uDD0A Only respond to my voice" android:textColor="@color/text_primary" android:layout_marginBottom="6dp" />
            <Switch android:id="@+id/requireUnlockSwitch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Require unlock before calls" android:textColor="@color/text_primary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Activity logging" android:textColor="@color/text_muted" android:textSize="12sp" />
            <Spinner android:id="@+id/logModeSpinner" android:layout_width="match_parent" android:layout_height="50dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Automatic deletion" android:textColor="@color/text_muted" android:textSize="12sp" />
            <Spinner android:id="@+id/retentionSpinner" android:layout_width="match_parent" android:layout_height="50dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Profiles and logs are encrypted on-device. Emergency and short-code calls always open the dialer instead of auto-calling."
                android:textColor="@color/text_muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
