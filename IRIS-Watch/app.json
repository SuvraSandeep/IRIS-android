{
  "configVersion": "v3",
  "app": {
    "appId": 20001,
    "appName": "IRIS Remote",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "IRIS",
    "description": "Experimental local phone remote"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "4.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "trex3": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480,
          "deviceSource": 8716545
        },
        {
          "st": "r",
          "dw": 480,
          "deviceSource": 8716547
        },
        {
          "st": "r",
          "dw": 480,
          "deviceSource": 8716544
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "IRIS Remote"
    }
  },
  "defaultLanguage": "en-US"
}
